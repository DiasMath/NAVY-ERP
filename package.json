{
  "name": "navy-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "tsc --noEmit",
    "test:rules": "firebase emulators:exec --only firestore --project demo-navy-rules \"node tests/firestore-rules.mjs\"",
    "test:admin": "firebase emulators:exec --only auth,firestore --project demo-navy-admin \"node tests/admin-integration.mjs\"",
    "test:field": "firebase emulators:exec --only auth,firestore --project demo-navy-field \"node tests/field-integration.mjs\""
  },
  "dependencies": {
    "firebase": "12.10.0",
    "firebase-admin": "13.10.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "firebase-tools": "^15.34.1",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "postcss": "8.5.31"
  }
}
