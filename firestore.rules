rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isMember(clinicId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().active == true
        && profile().clinicId == clinicId;
    }
    function legacyPermission(permission) {
      return profile().role in ['master_admin', 'admin']
        || (profile().role == 'reception' && permission in ['clients.read', 'clients.write', 'sessions.read', 'sessions.write', 'services.read', 'professionals.read', 'agenda.read', 'agenda.write', 'integrations.read'])
        || (profile().role == 'professional' && permission in ['clients.read', 'clients.write', 'sessions.read', 'sessions.write', 'services.read', 'professionals.read', 'agenda.read', 'integrations.read']);
    }
    function can(clinicId, permission) {
      return isMember(clinicId) && (profile().role == 'master_admin'
        || (profile().keys().hasAny(['permissions'])
          ? permission in profile().get('permissions', [])
          : legacyPermission(permission)));
    }

    // Perfis, papéis e grupos são alterados somente pela API administrativa.
    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /clinics/{clinicId}/{segment}/{documentId} {
      allow read: if (segment == 'clients' && can(clinicId, 'clients.read'))
        || (segment == 'services' && can(clinicId, 'services.read'))
        || (segment == 'professionals' && can(clinicId, 'professionals.read'))
        || (segment == 'appointments' && can(clinicId, 'agenda.read'))
        || (segment == 'sessions' && can(clinicId, 'sessions.read'));
      // Agendamentos são escritos pela API, que verifica conflitos em transação.
      allow create, update: if (segment == 'clients' && can(clinicId, 'clients.write'))
        || (segment == 'sessions' && can(clinicId, 'sessions.write'))
        || (segment == 'services' && can(clinicId, 'services.write'))
        || (segment == 'professionals' && can(clinicId, 'professionals.write'));
      // Clientes são excluídas apenas pela rota de servidor, que impede órfãos no Drive.
      allow delete: if (segment == 'services' && can(clinicId, 'services.delete'))
        || (segment == 'professionals' && can(clinicId, 'professionals.write'))
        || (segment == 'sessions' && can(clinicId, 'sessions.delete'));
    }

    match /{document=**} { allow read, write: if false; }
  }
}
